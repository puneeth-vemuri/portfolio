rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /portfolio/stats {
      allow read: if true;

      // Preserve the existing client counter UI while preventing arbitrary
      // writes, field injection, and counter resets. This is not a substitute
      // for a trusted server endpoint or per-user abuse controls.
      allow create: if
        request.resource.data.keys().hasOnly(['likes', 'views']) &&
        request.resource.data.keys().hasAll(['likes', 'views']) &&
        request.resource.data.likes == 0 &&
        request.resource.data.views == 1;

      allow update: if
        request.resource.data.keys().hasOnly(['likes', 'views']) &&
        request.resource.data.keys().hasAll(['likes', 'views']) &&
        (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
            request.resource.data.likes == resource.data.likes &&
            request.resource.data.views == resource.data.views + 1
          ) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
            request.resource.data.views == resource.data.views &&
            (
              request.resource.data.likes == resource.data.likes + 1 ||
              (
                resource.data.likes > 0 &&
                request.resource.data.likes == resource.data.likes - 1
              )
            )
          )
        );
      allow delete: if false;
    }

    match /feedback/{feedbackId} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasAll(['name', 'message', 'avatarColor', 'role', 'timestamp']) &&
        request.resource.data.keys().hasOnly(['name', 'message', 'avatarColor', 'role', 'timestamp']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 60 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 1000 &&
        request.resource.data.avatarColor is string &&
        request.resource.data.avatarColor in [
          'bg-red-600', 'bg-blue-600', 'bg-emerald-600', 'bg-purple-600',
          'bg-orange-600', 'bg-pink-600', 'bg-indigo-600'
        ] &&
        request.resource.data.role == 'VISITOR' &&
        request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}